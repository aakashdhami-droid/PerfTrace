# ── PerfTrace Environment Configuration ──
# Copy this file to .env and adjust variables as needed for your local environment.
# Never commit .env with real credentials or secrets to version control.

# ── Database (PostgreSQL 16) ──
PERFTRACE_DB_URL=jdbc:postgresql://localhost:5432/perftrace
PERFTRACE_DB_USER=perftrace
PERFTRACE_DB_PASSWORD=your_secure_db_password_here

# ── Server & Security ──
PERFTRACE_PORT=8080
# Secret must be at least 256 bits (32+ characters) for HMAC-SHA256
PERFTRACE_JWT_SECRET=your_at_least_32_character_jwt_secret_key_here_for_security
PERFTRACE_JWT_EXPIRATION_MS=86400000

# ── File Ingestion ──
PERFTRACE_MAX_UPLOAD_SIZE=50MB
